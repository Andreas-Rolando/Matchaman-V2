# ----------------------------------------------------
# Runtime
# ----------------------------------------------------

# On Vercel this is set to "production" automatically — do not add it there.
# Only relevant for local development and self-hosting (`npm run build:node`),
# where it switches on the SPA fallback in server.ts.
NODE_ENV="production"

# Port to listen on. Ignored on Vercel; used by server.ts locally.
PORT="3000"

# Public URL where this app is served, e.g. "https://order.matchaman.co.id".
# Used as the origin allowlist for state-changing API calls.
APP_URL=""

# Express "trust proxy" setting. Leave EMPTY when the app is reached directly.
# Set it when running behind a load balancer / reverse proxy, otherwise every
# user shares one rate-limit bucket because req.ip resolves to the proxy.
#   "1"        -> trust one hop (Vercel, Cloud Run, Heroku, most PaaS)
#   "loopback" -> trust a local nginx
# On Vercel this MUST be "1", or the order rate limit applies to the edge IP
# rather than the customer's.
# Warning: only enable this when a proxy really is in front, or clients can
# spoof X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=""

# ----------------------------------------------------
# ESB ESO-QS API Integration
# Documentation: https://developers.esb.co.id/eso-qs/
# ----------------------------------------------------

# ESB API Base URL
ESB_API_BASE_URL="https://eso-api.esb.co.id"

# ESB API Authentication Token (Bearer Token) — REQUIRED.
# Without it the /api/esb/* endpoints return 503.
# Get it from your ESB project PIC or via the Save Auth API.
ESB_API_TOKEN=""

# ESB Company Code, sent as the Data-Company header — REQUIRED.
ESB_COMPANY_CODE=""

# Note: Branch Code is dynamic — chosen by the user in the app.

# ESB API request timeout in ms (default 9000).
# Keep this comfortably below the function's maxDuration in vercel.json: the
# /api/esb/menu fallback path can chain several ESB calls back to back.
ESB_TIMEOUT_MS="9000"

# ----------------------------------------------------
# Rate limiting (Upstash Redis)
# https://console.upstash.com — create a Redis database, copy the REST creds.
# ----------------------------------------------------

# REQUIRED in production. Order creation spends real money against the
# merchant's ESB credentials, so its rate limit has to be shared across every
# serverless instance. Without these two vars the order endpoints refuse all
# traffic with a 503 rather than run unprotected.
# In development they are optional — the limiter falls back to an in-memory
# counter, which is equivalent when there is only one process.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
